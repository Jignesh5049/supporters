{
  "expo": {
    "name": "Supporters",
    "slug": "supporters",
    "scheme": "supporters",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c22125f1-cdea-411e-894e-49a50e37257a",
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.supporters.app",
      "associatedDomains": ["applinks:supporters.in"],
      "infoPlist": {
        "NSCameraUsageDescription": "Supporters needs access to your camera to capture product and workshop photos.",
        "NSPhotoLibraryUsageDescription": "Supporters needs access to your photo library to select catalog images and verification documents.",
        "NSFaceIDUsageDescription": "Allow Supporters to use Face ID for secure payout authorization.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.supporters.app",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "supporters.in"
            },
            {
              "scheme": "supporters"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c22125f1-cdea-411e-894e-49a50e37257a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share product images."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Supporters to use Face ID for secure payout authorization."
        }
      ]
    ]
  }
}
