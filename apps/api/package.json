{
  "name": "@supporters/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "storage:init": "tsx --env-file=.env scripts/init-storage.ts",
    "search:init": "tsx --env-file=.env scripts/init-search.ts",
    "search:reindex": "tsx --env-file=.env scripts/reindex-search.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "prisma generate && eslint .",
    "test": "prisma generate && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/client-sesv2": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/under-pressure": "9.2.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.12.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@supporters/shared": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.5.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "meilisearch": "0.62.0",
    "openapi-types": "12.1.3",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
