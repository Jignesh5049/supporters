// Identity, business and catalog tables (backend spec, "Data model"). Every table has a UUIDv7 id
// from PostgreSQL 18's native uuidv7(), plus created_at and updated_at.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // For the partial indexes on published listings (backend spec, Data model).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum OtpPurpose {
  signup
  login_reset
  email_verify
  phone_change

  @@map("otp_purpose")
}

enum DevicePlatform {
  android
  ios
  web

  @@map("device_platform")
}

model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// E.164, +91 only.
  phone           String     @unique(map: "uq_users_phone")
  /// Stored lower-cased so the unique index is case-insensitive.
  email           String?    @unique(map: "uq_users_email")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  name            String
  passwordHash    String     @map("password_hash")
  role            UserRole   @default(user)
  status          UserStatus @default(active)
  cityId          String?    @map("city_id") @db.Uuid
  /// Admins only, encrypted at the application layer.
  totpSecret      Bytes?     @map("totp_secret")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  city                 City?                  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  sessions             Session[]
  devices              Device[]
  consents             Consent[]
  interests            UserInterest[]
  business             Business?
  uploads              Upload[]
  comments             Comment[]
  likes                Like[]
  saves                Save[]
  follows              Follow[]
  feedSeen             FeedSeen[]
  conversations        Conversation[]
  sentMessages         Message[]
  hiddenMessages       MessageHidden[]
  enquiries            Enquiry[]
  blocksMade           Block[]                @relation("Blocker")
  blocksReceived       Block[]                @relation("Blocked")
  notifications        Notification[]         @relation("NotificationRecipient")
  actedOn              Notification[]         @relation("NotificationActor")
  notificationPrefs    NotificationPref[]
  pushTokens           PushToken[]
  webPushSubscriptions WebPushSubscription[]
  buyerRequirements    BuyerRequirement[]
  verificationReviews  BusinessVerification[] @relation("VerificationReviewer")
  reportsMade          Report[]               @relation("Reporter")
  reportsResolved      Report[]               @relation("ReportResolver")
  auditLogs            AuditLog[]
  reviews              Review[]
  referralCode         ReferralCode?
  referralsMade        Referral[]             @relation("ReferralReferrer")
  referralsReceived    Referral[]             @relation("ReferralReferred")
  wallet               Wallet?
  walletLedger         WalletLedger[]
  payoutAccounts       PayoutAccount[]
  withdrawals          Withdrawal[]           @relation("WithdrawalOwner")
  withdrawalsReviewed  Withdrawal[]           @relation("WithdrawalReviewer")

  @@map("users")
}

model UserInterest {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId], map: "uq_user_interests_user_id_category_id")
  @@index([categoryId], map: "idx_user_interests_category_id")
  @@map("user_interests")
}

model Session {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// Groups every refresh token issued from one sign-in; revoked together on reuse.
  familyId          String    @map("family_id") @db.Uuid
  deviceId          String?   @map("device_id") @db.Uuid
  /// SHA-256 of the current refresh token.
  refreshTokenHash  String    @unique(map: "uq_sessions_refresh_token_hash") @map("refresh_token_hash")
  /// SHA-256 of the token it replaced, accepted for the grace window after rotated_at.
  previousTokenHash String?   @unique(map: "uq_sessions_previous_token_hash") @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Sliding expiry (30 days from the last refresh, capped at absolute_expires_at).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  userAgent         String?   @map("user_agent")
  ip                String?
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  device               Device?               @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  pushTokens           PushToken[]
  webPushSubscriptions WebPushSubscription[]

  @@index([userId, revokedAt], map: "idx_sessions_user_id_revoked_at")
  @@index([familyId], map: "idx_sessions_family_id")
  @@index([deviceId], map: "idx_sessions_device_id")
  @@map("sessions")
}

model OtpCode {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purpose    OtpPurpose
  /// The phone (E.164) or lower-cased email the code was sent to.
  target     String
  /// HMAC-SHA256 of purpose, target and code.
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([target, purpose, createdAt], map: "idx_otp_codes_target_purpose_created_at")
  @@index([expiresAt], map: "idx_otp_codes_expires_at")
  @@map("otp_codes")
}

model Device {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  platform          DevicePlatform
  appVersion        String?        @map("app_version")
  /// Play Integrity or App Attest result; a failure flags the account for review.
  attestationPassed Boolean?       @map("attestation_passed")
  lastSeenAt        DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId], map: "idx_devices_user_id")
  @@map("devices")
}

model Consent {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  /// Version of the terms and privacy policy the user accepted.
  policyVersion String   @map("policy_version")
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_consents_user_id")
  @@map("consents")
}

enum BusinessType {
  manufacturer
  wholesaler
  retailer
  distributor
  brand
  service_provider

  @@map("business_type")
}

enum VerificationStatus {
  none
  pending
  verified
  rejected

  @@map("verification_status")
}

enum ListingStatus {
  draft
  published
  archived

  @@map("listing_status")
}

enum ProductAvailability {
  in_stock
  made_to_order
  bulk

  @@map("product_availability")
}

enum ServiceAvailability {
  immediate
  within_24_hours
  by_appointment

  @@map("service_availability")
}

/// States and union territories. Reference data loaded by prisma/seed.ts.
model State {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// ISO 3166-2:IN suffix, e.g. MH.
  code      String   @unique(map: "uq_states_code")
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cities     City[]
  businesses Business[]

  @@map("states")
}

model City {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  state        State              @relation(fields: [stateId], references: [id], onDelete: Restrict)
  users        User[]
  businesses   Business[]
  enquiries    Enquiry[]
  requirements BuyerRequirement[]

  @@unique([stateId, name], map: "uq_cities_state_id_name")
  @@map("cities")
}

/// Two levels: a category has no parent, a subcategory's parent is a category.
model Category {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String
  slug      String   @unique(map: "uq_categories_slug")
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent                Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              Category[]         @relation("CategoryTree")
  interests             UserInterest[]
  businesses            Business[]         @relation("BusinessCategory")
  subcategoryBusinesses Business[]         @relation("BusinessSubcategory")
  products              Product[]
  services              Service[]
  requirements          BuyerRequirement[]

  @@index([parentId, position], map: "idx_categories_parent_id_position")
  @@map("categories")
}

model Business {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// One business per account (product spec, Decisions 3).
  ownerUserId        String             @unique(map: "uq_businesses_owner_user_id") @map("owner_user_id") @db.Uuid
  /// Immutable once verified_at is set.
  slug               String             @unique(map: "uq_businesses_slug")
  name               String
  type               BusinessType
  categoryId         String             @map("category_id") @db.Uuid
  subcategoryId      String?            @map("subcategory_id") @db.Uuid
  logoUploadId       String?            @unique(map: "uq_businesses_logo_upload_id") @map("logo_upload_id") @db.Uuid
  coverUploadId      String?            @unique(map: "uq_businesses_cover_upload_id") @map("cover_upload_id") @db.Uuid
  cityId             String             @map("city_id") @db.Uuid
  /// Always the city's state; kept for filtering without a join.
  stateId            String             @map("state_id") @db.Uuid
  gstin              String?
  about              String?
  establishedYear    Int?               @map("established_year") @db.SmallInt
  tags               String[]           @default([])
  website            String?
  contactPerson      String?            @map("contact_person")
  contactPhone       String?            @map("contact_phone")
  contactEmail       String?            @map("contact_email")
  isContactPublic    Boolean            @default(false) @map("is_contact_public")
  address            String?
  pincode            String?
  mapUrl             String?            @map("map_url")
  socials            Json               @default("{}")
  openingHours       Json               @default("[]") @map("opening_hours")
  verificationStatus VerificationStatus @default(none) @map("verification_status")
  /// First verification; locks the slug for good.
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  premiumUntil       DateTime?          @map("premium_until") @db.Timestamptz(6)
  profileCompletion  Int                @default(0) @map("profile_completion") @db.SmallInt
  /// Denormalized; changed in the same transaction as the follow.
  followerCount      Int                @default(0) @map("follower_count")
  /// Hidden by moderation: gone from every public read, with its posts and listings.
  hiddenAt           DateTime?          @map("hidden_at") @db.Timestamptz(6)
  /// Average of visible reviews to one decimal (null with none), recomputed on every review change.
  ratingAvg          Decimal?           @map("rating_avg") @db.Decimal(2, 1)
  ratingCount        Int                @default(0) @map("rating_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner              User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  category           Category               @relation("BusinessCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory        Category?              @relation("BusinessSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  city               City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  state              State                  @relation(fields: [stateId], references: [id], onDelete: Restrict)
  logo               Upload?                @relation("BusinessLogo", fields: [logoUploadId], references: [id], onDelete: SetNull)
  cover              Upload?                @relation("BusinessCover", fields: [coverUploadId], references: [id], onDelete: SetNull)
  products           Product[]
  posts              Post[]
  followers          Follow[]
  services           Service[]
  conversations      Conversation[]
  enquiries          Enquiry[]
  requirementMatches RequirementMatch[]
  requirementQuotes  RequirementQuote[]
  verifications      BusinessVerification[]
  reviews            Review[]

  @@index([categoryId], map: "idx_businesses_category_id")
  @@index([subcategoryId], map: "idx_businesses_subcategory_id")
  @@index([cityId], map: "idx_businesses_city_id")
  @@index([stateId], map: "idx_businesses_state_id")
  @@map("businesses")
}

model Product {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  categoryId         String              @map("category_id") @db.Uuid
  title              String
  description        String
  /// Null means "Ask for price".
  pricePaise         BigInt?             @map("price_paise")
  originalPricePaise BigInt?             @map("original_price_paise")
  unit               String?
  moq                Int?
  availability       ProductAvailability @default(in_stock)
  deliveryTime       String?             @map("delivery_time")
  isAllIndia         Boolean             @default(true) @map("is_all_india")
  areaStateIds       String[]            @default([]) @map("area_state_ids") @db.Uuid
  /// Ordered [{ key, value }], up to 30.
  specs              Json                @default("[]")
  status             ListingStatus       @default(draft)
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(6)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media     ListingMedia[]
  posts     Post[]
  enquiries Enquiry[]
  messages  Message[]
  quotes    RequirementQuote[]

  /// UUIDv7 ids sort by creation time, so pages order by id.
  @@index([businessId, status, id], map: "idx_products_business_id_status_id")
  @@index([categoryId, id], map: "idx_products_published_category_id_id", where: raw("status = 'published' AND deleted_at IS NULL"))
  @@map("products")
}

model Service {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String              @map("business_id") @db.Uuid
  categoryId   String              @map("category_id") @db.Uuid
  title        String
  description  String
  /// Starting price. Null means "Ask for price".
  pricePaise   BigInt?             @map("price_paise")
  priceUnit    String?             @map("price_unit")
  turnaround   String?
  availability ServiceAvailability @default(by_appointment)
  isAllIndia   Boolean             @default(true) @map("is_all_india")
  areaStateIds String[]            @default([]) @map("area_state_ids") @db.Uuid
  areaCityIds  String[]            @default([]) @map("area_city_ids") @db.Uuid
  features     String[]            @default([])
  status       ListingStatus       @default(draft)
  publishedAt  DateTime?           @map("published_at") @db.Timestamptz(6)
  deletedAt    DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media     ListingMedia[]
  posts     Post[]
  enquiries Enquiry[]
  messages  Message[]
  quotes    RequirementQuote[]

  /// UUIDv7 ids sort by creation time, so pages order by id.
  @@index([businessId, status, id], map: "idx_services_business_id_status_id")
  @@index([categoryId, id], map: "idx_services_published_category_id_id", where: raw("status = 'published' AND deleted_at IS NULL"))
  @@map("services")
}

enum UploadPurpose {
  avatar
  cover
  listing
  post
  chat
  kyc
  requirement

  @@map("upload_purpose")
}

/// pending -> processing -> ready | failed. rejected is legacy: nothing writes it any more.
enum UploadStatus {
  pending
  processing
  ready
  failed
  rejected

  @@map("upload_status")
}

/// A file uploaded straight to S3 through a presigned PUT (backend spec, Security: Uploads).
/// Unreferenced uploads older than 24 h are orphans for the nightly cleanup job.
model Upload {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  purpose       UploadPurpose
  /// Object key: public/<purpose>/<random> for public media, chat/ or kyc/ otherwise.
  key           String        @unique(map: "uq_uploads_key")
  contentType   String        @map("content_type")
  sizeBytes     Int           @map("size_bytes")
  status        UploadStatus  @default(pending)
  /// Why the upload is failed (a code from UPLOAD_FAILURE_MESSAGES in packages/shared).
  failureReason String?       @map("failure_reason")
  completedAt   DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingMedia         ListingMedia?
  postMedia            PostMedia?
  businessLogo         Business?             @relation("BusinessLogo")
  businessCover        Business?             @relation("BusinessCover")
  attachment           MessageAttachment?
  requirementImage     RequirementImage?
  verificationDocument VerificationDocument?

  @@index([userId, createdAt], map: "idx_uploads_user_id_created_at")
  @@index([status, createdAt], map: "idx_uploads_status_created_at")
  @@map("uploads")
}

/// Ordered images of a product or a service; exactly one of the two is set (CHECK in the migration).
model ListingMedia {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  uploadId  String   @unique(map: "uq_listing_media_upload_id") @map("upload_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  serviceId String?  @map("service_id") @db.Uuid
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  upload  Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([productId, position], map: "idx_listing_media_product_id_position")
  @@index([serviceId, position], map: "idx_listing_media_service_id_position")
  @@map("listing_media")
}

enum PostType {
  product
  service
  update
  offer
  testimonial

  @@map("post_type")
}

enum PostStatus {
  draft
  published
  archived

  @@map("post_status")
}

/// A business page's post (product spec, Feed and social). At most one of product_id and
/// service_id is set (CHECK in the migration); counters never go below zero.
model Post {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String     @map("business_id") @db.Uuid
  type         PostType
  body         String     @default("")
  /// Offers only, e.g. "20% off".
  offerTag     String?    @map("offer_tag")
  offerEndsAt  DateTime?  @map("offer_ends_at") @db.Timestamptz(6)
  /// An attached listing of the same business, shown as a card.
  productId    String?    @map("product_id") @db.Uuid
  serviceId    String?    @map("service_id") @db.Uuid
  status       PostStatus @default(draft)
  /// Set on the first publish and never moved, so the 7-day limit counts publishes.
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(6)
  /// Denormalized; changed in the same transaction as the like, comment or save.
  likeCount    Int        @default(0) @map("like_count")
  commentCount Int        @default(0) @map("comment_count")
  saveCount    Int        @default(0) @map("save_count")
  /// Hidden by moderation (an admin, or enough distinct reports); gone from public reads.
  hiddenAt     DateTime?  @map("hidden_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  service  Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  media    PostMedia[]
  comments Comment[]
  likes    Like[]
  seenBy   FeedSeen[]

  /// The owner's list (UUIDv7 ids sort by creation time).
  @@index([businessId, status, id], map: "idx_posts_business_id_status_id")
  /// A business's public tab, and the free plan's publishes-per-7-days count.
  @@index([businessId, publishedAt, id], map: "idx_posts_business_id_published_at_id")
  /// The feed: every live post, newest first. The predicate avoids enum literals: Prisma
  /// binds enums as CAST($n::text AS post_status), which the planner cannot match to one.
  @@index([publishedAt, id], map: "idx_posts_published_published_at_id", where: raw("published_at IS NOT NULL AND deleted_at IS NULL"))
  @@index([productId], map: "idx_posts_product_id", where: raw("product_id IS NOT NULL"))
  @@index([serviceId], map: "idx_posts_service_id", where: raw("service_id IS NOT NULL"))
  @@map("posts")
}

/// Ordered media of a post: 1 to 10 images or one video (checked by the API).
model PostMedia {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  uploadId  String   @unique(map: "uq_post_media_upload_id") @map("upload_id") @db.Uuid
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([postId, position], map: "idx_post_media_post_id_position")
  @@map("post_media")
}

/// One level of replies: a reply's parent must be a top-level comment (checked by the API).
model Comment {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId     String    @map("post_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  body       String
  /// Live replies; top-level comments only.
  replyCount Int       @default(0) @map("reply_count")
  /// Hidden by moderation; gone from public reads.
  hiddenAt   DateTime? @map("hidden_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  /// Top-level comments of a post, or replies of a comment, newest first.
  @@index([postId, parentId, id], map: "idx_comments_post_id_parent_id_id")
  @@index([parentId, id], map: "idx_comments_parent_id_id", where: raw("parent_id IS NOT NULL"))
  @@index([userId], map: "idx_comments_user_id")
  @@map("comments")
}

model Like {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId], map: "uq_likes_user_id_post_id")
  @@index([postId], map: "idx_likes_post_id")
  @@map("likes")
}

enum SaveTargetType {
  post
  product
  service
  business

  @@map("save_target_type")
}

/// A bookmark. target_id points at a post, product, service or business (no FK: polymorphic).
model Save {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  targetType SaveTargetType @map("target_type")
  targetId   String         @map("target_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId], map: "uq_saves_user_id_target_type_target_id")
  /// The Saved list, all types or one type tab, newest first.
  @@index([userId, id], map: "idx_saves_user_id_id")
  @@index([userId, targetType, id], map: "idx_saves_user_id_target_type_id")
  @@index([targetType, targetId], map: "idx_saves_target_type_target_id")
  @@map("saves")
}

/// Users follow businesses only (product spec, Decisions 2).
model Follow {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId], map: "uq_follows_user_id_business_id")
  @@index([userId, id], map: "idx_follows_user_id_id")
  @@index([businessId, id], map: "idx_follows_business_id_id")
  @@map("follows")
}

/// Posts a user has seen, skipped by the feed's city and state fill.
model FeedSeen {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId], map: "uq_feed_seen_user_id_post_id")
  @@index([postId], map: "idx_feed_seen_post_id")
  @@map("feed_seen")
}

enum ChatSide {
  user
  business

  @@map("chat_side")
}

enum MessageType {
  text
  image
  file
  listing_card
  enquiry
  quote

  @@map("message_type")
}

enum EnquiryStatus {
  new
  responded
  closed

  @@map("enquiry_status")
}

/// One thread per (user, business). The business side is answered by the owner of the business.
model Conversation {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  /// Time of the newest message (or of creation), for ordering the inbox.
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages  Message[]
  states    ConversationState[]
  enquiries Enquiry[]
  quotes    RequirementQuote[]

  @@unique([userId, businessId], map: "uq_conversations_user_id_business_id")
  @@index([userId, lastMessageAt, id], map: "idx_conversations_user_id_last_message_at_id")
  @@index([businessId, lastMessageAt, id], map: "idx_conversations_business_id_last_message_at_id")
  @@map("conversations")
}

/// Per-side read pointer and controls. Rows are created on first use.
model ConversationState {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  side              ChatSide
  lastReadMessageId String?  @map("last_read_message_id") @db.Uuid
  muted             Boolean  @default(false)
  hidden            Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, side], map: "uq_conversation_state_conversation_id_side")
  @@map("conversation_state")
}

model Message {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderUserId   String      @map("sender_user_id") @db.Uuid
  senderSide     ChatSide    @map("sender_side")
  /// Client-generated UUID; unique per sender so a retried send is stored once.
  clientId       String      @map("client_id") @db.Uuid
  /// SHA-256 of the send payload, to tell a retry from a reused key with another body.
  requestHash    String      @map("request_hash")
  type           MessageType
  body           String      @default("")
  /// A listing_card message points at one product or service.
  productId      String?     @map("product_id") @db.Uuid
  serviceId      String?     @map("service_id") @db.Uuid
  /// Hidden by moderation, for both sides of the thread.
  hiddenAt       DateTime?   @map("hidden_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  product      Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  service      Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  hiddenFor    MessageHidden[]
  enquiry      Enquiry?
  quote        RequirementQuote?

  @@unique([senderUserId, clientId], map: "uq_messages_sender_user_id_client_id")
  @@index([conversationId, id], map: "idx_messages_conversation_id_id")
  @@index([productId], map: "idx_messages_product_id", where: raw("product_id IS NOT NULL"))
  @@index([serviceId], map: "idx_messages_service_id", where: raw("service_id IS NOT NULL"))
  @@map("messages")
}

/// A chat upload attached to a message. Private: served only through signed URLs.
model MessageAttachment {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  uploadId  String   @unique(map: "uq_message_attachments_upload_id") @map("upload_id") @db.Uuid
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  upload  Upload  @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([messageId, position], map: "idx_message_attachments_message_id_position")
  @@map("message_attachments")
}

/// Delete for me: the message stays for the other person.
model MessageHidden {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId], map: "uq_message_hidden_message_id_user_id")
  @@index([userId], map: "idx_message_hidden_user_id")
  @@map("message_hidden")
}

/// The structured first message (Contact Supplier); it shows in the enquiry list of the business.
model Enquiry {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  conversationId  String        @map("conversation_id") @db.Uuid
  messageId       String        @unique(map: "uq_enquiries_message_id") @map("message_id") @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  serviceId       String?       @map("service_id") @db.Uuid
  quantity        Int?
  unit            String?
  deliveryCityId  String?       @map("delivery_city_id") @db.Uuid
  message         String
  sharePhone      Boolean       @default(false) @map("share_phone")
  status          EnquiryStatus @default(new)
  /// When the owner first replied; response time and rate come from this.
  firstResponseAt DateTime?     @map("first_response_at") @db.Timestamptz(6)
  closedAt        DateTime?     @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chatMessage  Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  deliveryCity City?        @relation(fields: [deliveryCityId], references: [id], onDelete: SetNull)

  @@index([userId, id], map: "idx_enquiries_user_id_id")
  @@index([businessId, status, id], map: "idx_enquiries_business_id_status_id")
  @@index([conversationId, status], map: "idx_enquiries_conversation_id_status")
  @@index([productId, createdAt], map: "idx_enquiries_product_id_created_at", where: raw("product_id IS NOT NULL"))
  @@index([serviceId, createdAt], map: "idx_enquiries_service_id_created_at", where: raw("service_id IS NOT NULL"))
  @@map("enquiries")
}

model Block {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], map: "uq_blocks_blocker_id_blocked_id")
  @@index([blockedId], map: "idx_blocks_blocked_id")
  @@map("blocks")
}

// Notifications (backend spec, Data model: Notifications; product spec, Notifications).

enum NotificationCategory {
  messages
  enquiries
  business
  referrals
  subscription
  account

  @@map("notification_category")
}

enum NotificationChannel {
  push
  email

  @@map("notification_channel")
}

/// One in-app item. Batched events (likes, comments, follows) grow one unread row per group_key
/// for 10 minutes instead of adding rows. Deleted after 90 days.
model Notification {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The recipient.
  userId      String               @map("user_id") @db.Uuid
  /// e.g. post.liked (NotificationType in packages/shared).
  type        String
  category    NotificationCategory
  /// The latest person behind it; null for system events.
  actorUserId String?              @map("actor_user_id") @db.Uuid
  actorCount  Int                  @default(1) @map("actor_count")
  /// conversation, enquiry, post, business or account.
  targetType  String               @map("target_type")
  targetId    String?              @map("target_id") @db.Uuid
  /// Events with the same key batch together, e.g. post.liked:<post id>.
  groupKey    String?              @map("group_key")
  readAt      DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, id], map: "idx_notifications_user_id_id")
  @@index([userId, category, id], map: "idx_notifications_user_id_category_id")
  /// The unread badge.
  @@index([userId], map: "idx_notifications_user_id_unread", where: raw("read_at IS NULL"))
  /// Finding the open batch to grow.
  @@index([userId, groupKey, createdAt], map: "idx_notifications_user_id_group_key_created_at", where: raw("group_key IS NOT NULL AND read_at IS NULL"))
  @@index([actorUserId], map: "idx_notifications_actor_user_id")
  /// The 90-day cleanup.
  @@index([createdAt], map: "idx_notifications_created_at")
  @@map("notifications")
}

/// Off switches. A missing row means the channel is on for that category.
model NotificationPref {
  id        String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel], map: "uq_notification_prefs_user_id_category_channel")
  @@map("notification_prefs")
}

/// An Expo push token, tied to the session that registered it: a signed-out device gets no push.
model PushToken {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  sessionId  String         @map("session_id") @db.Uuid
  /// ExponentPushToken[...]. A device that switches accounts moves to the new account.
  token      String         @unique(map: "uq_push_tokens_token")
  platform   DevicePlatform
  lastUsedAt DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, id], map: "idx_push_tokens_user_id_id")
  @@index([sessionId], map: "idx_push_tokens_session_id")
  @@map("push_tokens")
}

/// A browser's Web Push subscription (opt-in from Settings), tied to the session like push_tokens.
model WebPushSubscription {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  /// The push service URL; only known push services are accepted.
  endpoint   String   @unique(map: "uq_web_push_subscriptions_endpoint")
  p256dh     String
  auth       String
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, id], map: "idx_web_push_subscriptions_user_id_id")
  @@index([sessionId], map: "idx_web_push_subscriptions_session_id")
  @@map("web_push_subscriptions")
}

/// Domain events, written in the same transaction as the change (transactional outbox). The
/// worker relays unpublished rows to the notifications queue, and records what it fanned out.
model OutboxEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// entity.verb, e.g. enquiry.created.
  type        String
  /// Ids only: never message text or contact details.
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  /// The deliveries decided when it was processed, so a retried job re-queues the same ones.
  fanout      Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([id], map: "idx_outbox_events_unpublished", where: raw("published_at IS NULL"))
  @@index([processedAt], map: "idx_outbox_events_processed_at", where: raw("processed_at IS NOT NULL"))
  @@map("outbox_events")
}

// Verification and trust and safety (backend spec, Data model: Business, Trust and safety).

enum VerificationMethod {
  gstin
  udyam

  @@map("verification_method")
}

enum VerificationRequestStatus {
  pending
  approved
  rejected

  @@map("verification_request_status")
}

enum VerificationDocumentKind {
  certificate
  owner_id

  @@map("verification_document_kind")
}

/// One verification request. A business has at most one pending request (partial unique index
/// in the migration); the business's verification_status is the badge itself.
model BusinessVerification {
  id                 String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId         String                    @map("business_id") @db.Uuid
  method             VerificationMethod
  /// The GSTIN or Udyam number the admin checks on the government portal.
  registrationNumber String                    @map("registration_number")
  status             VerificationRequestStatus @default(pending)
  rejectionReason    String?                   @map("rejection_reason")
  reviewedByUserId   String?                   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business  Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer  User?                  @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  documents VerificationDocument[]

  /// At most one pending request per business.
  @@unique([businessId], map: "uq_business_verifications_business_id_pending", where: raw("status = 'pending'"))
  @@index([businessId, id], map: "idx_business_verifications_business_id_id")
  /// The admin queue, oldest first per status.
  @@index([status, id], map: "idx_business_verifications_status_id")
  @@map("business_verifications")
}

/// A kyc upload (S3 key under the private kyc/ prefix) attached to a request.
model VerificationDocument {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  verificationId String                   @map("verification_id") @db.Uuid
  uploadId       String                   @unique(map: "uq_verification_documents_upload_id") @map("upload_id") @db.Uuid
  kind           VerificationDocumentKind
  position       Int                      @db.SmallInt
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  verification BusinessVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  /// Restrict: the evidence for a decision is never dropped by upload cleanup.
  upload       Upload               @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@index([verificationId, position], map: "idx_verification_documents_verification_id_position")
  @@map("verification_documents")
}

enum ReportTargetType {
  post
  comment
  review
  message
  business
  requirement

  @@map("report_target_type")
}

enum ReportReason {
  spam
  fraud
  offensive
  wrong_category
  other

  @@map("report_reason")
}

enum ReportStatus {
  open
  actioned
  dismissed

  @@map("report_status")
}

enum ReportAction {
  dismiss
  hide
  warn
  suspend

  @@map("report_action")
}

/// A user's report of a post, comment, review, message, business or requirement. target_id has no
/// FK (polymorphic). One report per reporter and target, so open reports count distinct people.
model Report {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reporterUserId   String           @map("reporter_user_id") @db.Uuid
  targetType       ReportTargetType @map("target_type")
  targetId         String           @map("target_id") @db.Uuid
  /// The author or owner of the target when it was reported: who a warning or suspension hits.
  subjectUserId    String           @map("subject_user_id") @db.Uuid
  reason           ReportReason
  details          String?
  status           ReportStatus     @default(open)
  action           ReportAction?
  resolutionNote   String?          @map("resolution_note")
  resolvedByUserId String?          @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter   User  @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@unique([reporterUserId, targetType, targetId], map: "uq_reports_reporter_user_id_target_type_target_id")
  /// The admin queue.
  @@index([status, id], map: "idx_reports_status_id")
  /// Open reports on one target (auto-hide count, resolving them together).
  @@index([targetType, targetId, status], map: "idx_reports_target_type_target_id_status")
  @@index([subjectUserId], map: "idx_reports_subject_user_id")
  @@map("reports")
}

/// Append-only record of admin actions (backend spec, Security: Admin). UPDATE and DELETE are
/// refused by a trigger in the migration; rows are kept for a year. No updated_at: rows never change.
model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  /// resource.verb, e.g. verification.approve.
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  /// Ids, statuses and reasons only: never passwords, tokens or document contents.
  metadata    Json     @default("{}")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, id], map: "idx_audit_logs_actor_user_id_id")
  @@index([targetType, targetId, id], map: "idx_audit_logs_target_type_target_id_id")
  @@index([action, id], map: "idx_audit_logs_action_id")
  @@map("audit_logs")
}

// Buyer requirements (product spec, Discovery and buyer requirements; backend spec, Data model:
// Discovery).

enum RequirementStatus {
  open
  closed
  fulfilled
  expired

  @@map("requirement_status")
}

/// What a buyer needs, shown to matching businesses for 30 days. An open row past expires_at
/// counts as expired even before the hourly cron flips its status.
model BuyerRequirement {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  /// A top-level category or a subcategory; matching uses its top-level category.
  categoryId     String            @map("category_id") @db.Uuid
  description    String
  quantity       Int
  unit           String
  deliveryCityId String            @map("delivery_city_id") @db.Uuid
  budgetPaise    BigInt?           @map("budget_paise")
  status         RequirementStatus @default(open)
  /// Denormalized; changed in the same transaction as the quote.
  quoteCount     Int               @default(0) @map("quote_count")
  /// Set by the matching job; null until it has run.
  matchedAt      DateTime?         @map("matched_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  /// When it left the open state (closed, fulfilled or expired).
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  deliveryCity City               @relation(fields: [deliveryCityId], references: [id], onDelete: Restrict)
  images       RequirementImage[]
  matches      RequirementMatch[]
  quotes       RequirementQuote[]

  @@index([categoryId, deliveryCityId, status], map: "idx_buyer_requirements_category_id_delivery_city_id_status")
  /// The buyer's list and the 10-open check.
  @@index([userId, status, id], map: "idx_buyer_requirements_user_id_status_id")
  /// The expiry cron.
  @@index([status, expiresAt], map: "idx_buyer_requirements_status_expires_at")
  @@map("buyer_requirements")
}

/// Ordered images of a requirement (up to 3).
model RequirementImage {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requirementId String   @map("requirement_id") @db.Uuid
  uploadId      String   @unique(map: "uq_requirement_images_upload_id") @map("upload_id") @db.Uuid
  position      Int      @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  requirement BuyerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  upload      Upload           @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([requirementId, position], map: "idx_requirement_images_requirement_id_position")
  @@map("requirement_images")
}

/// A business the requirement was shown to. rank orders the matches (1 is best); the top
/// verified ones also get notified_at.
model RequirementMatch {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requirementId String    @map("requirement_id") @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  rank          Int
  notifiedAt    DateTime? @map("notified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  requirement BuyerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([requirementId, businessId], map: "uq_requirement_matches_requirement_id_business_id")
  /// A business's Requirements list, newest requirement first.
  @@index([businessId, requirementId], map: "idx_requirement_matches_business_id_requirement_id")
  @@map("requirement_matches")
}

/// One quote per business per requirement. It is also a `quote` message in the DM thread.
model RequirementQuote {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requirementId  String   @map("requirement_id") @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  pricePaise     BigInt   @map("price_paise")
  message        String
  /// An optional listing of the quoting business.
  productId      String?  @map("product_id") @db.Uuid
  serviceId      String?  @map("service_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @unique(map: "uq_requirement_quotes_message_id") @map("message_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  requirement  BuyerRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product      Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  service      Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chatMessage  Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([requirementId, businessId], map: "uq_requirement_quotes_requirement_id_business_id")
  @@index([requirementId, id], map: "idx_requirement_quotes_requirement_id_id")
  /// The 50-per-day count of a business.
  @@index([businessId, createdAt], map: "idx_requirement_quotes_business_id_created_at")
  @@index([conversationId], map: "idx_requirement_quotes_conversation_id")
  @@index([productId], map: "idx_requirement_quotes_product_id", where: raw("product_id IS NOT NULL"))
  @@index([serviceId], map: "idx_requirement_quotes_service_id", where: raw("service_id IS NOT NULL"))
  @@map("requirement_quotes")
}

// Reviews (product spec, Reviews and ratings; backend spec, Data model: Reviews).

/// One review per user per business. Hidden reviews (admin moderation) leave the average.
model Review {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// 1 to 5 stars (CHECK in the migration).
  rating         Int       @db.SmallInt
  body           String
  ownerReply     String?   @map("owner_reply")
  ownerRepliedAt DateTime? @map("owner_replied_at") @db.Timestamptz(6)
  hiddenAt       DateTime? @map("hidden_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId], map: "uq_reviews_user_id_business_id")
  /// A business's Reviews tab, newest first.
  @@index([businessId, id], map: "idx_reviews_business_id_id")
  @@map("reviews")
}

// Referrals and the wallet (product spec, Referral and earn, Wallet; backend spec, Security:
// Payments and money). Money is integer paise (BIGINT).

enum ReferralStatus {
  pending
  successful
  ineligible
  failed

  @@map("referral_status")
}

enum LedgerEntryType {
  referral_reward
  bonus
  reversal
  withdrawal

  @@map("ledger_entry_type")
}

/// One unguessable code per user: 8 characters, stored upper-case so lookups are case-insensitive.
model ReferralCode {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @unique(map: "uq_referral_codes_user_id") @map("user_id") @db.Uuid
  code      String   @unique(map: "uq_referral_codes_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

/// A referral is created at signup. It stays pending until the referred business buys Premium and
/// the refund window passes (`eligible_at`), then a finalizer job credits the ledger.
model Referral {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  referrerUserId     String         @map("referrer_user_id") @db.Uuid
  /// One referral per referred account.
  referredUserId     String         @unique(map: "uq_referrals_referred_user_id") @map("referred_user_id") @db.Uuid
  status             ReferralStatus @default(pending)
  /// ReferralReason in packages/shared; always set, so every status shows why.
  reason             String
  /// HMAC of the referred phone, to spot a number that signed up before (deleted account).
  phoneHash          String         @map("phone_hash")
  /// HMAC of the signup IP. Recorded for review; not an automatic rule (shared office networks).
  signupIpHash       String?        @map("signup_ip_hash")
  /// Device key from attestation. HOOK: nothing sets it yet (see referrals.signals.ts).
  deviceKeyHash      String?        @map("device_key_hash")
  /// Play Integrity / App Attest result at signup; false blocks the reward. Null: not attested.
  attestationPassed  Boolean?       @map("attestation_passed")
  /// Set by premium.activated. Plain ids: the payments tables belong to the Premium module.
  businessId         String?        @map("business_id") @db.Uuid
  paymentId          String?        @map("payment_id") @db.Uuid
  premiumActivatedAt DateTime?      @map("premium_activated_at") @db.Timestamptz(6)
  /// premium_activated_at plus the 7-day refund window.
  eligibleAt         DateTime?      @map("eligible_at") @db.Timestamptz(6)
  rewardPaise        BigInt?        @map("reward_paise")
  resolvedAt         DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  referrer User           @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Restrict)
  referred User           @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)
  ledger   WalletLedger[]

  @@index([referrerUserId, id], map: "idx_referrals_referrer_user_id_id")
  @@index([phoneHash], map: "idx_referrals_phone_hash")
  @@index([deviceKeyHash], map: "idx_referrals_device_key_hash")
  /// The finalizer's scan.
  @@index([eligibleAt], map: "idx_referrals_pending_eligible_at", where: raw("status = 'pending' AND eligible_at IS NOT NULL"))
  @@map("referrals")
}

/// One row per user, locked with SELECT ... FOR UPDATE by every wallet change. Holds no balance:
/// the balance is SUM(wallet_ledger.amount_paise).
model Wallet {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @unique(map: "uq_wallets_user_id") @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

/// Append-only (a trigger refuses UPDATE and DELETE). Positive amounts credit, negative debit.
/// `entry_key` makes every posting idempotent: referral:<id>, withdrawal:<id>, ...
model WalletLedger {
  id           String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  type         LedgerEntryType
  amountPaise  BigInt          @map("amount_paise")
  entryKey     String          @unique(map: "uq_wallet_ledger_entry_key") @map("entry_key")
  referralId   String?         @map("referral_id") @db.Uuid
  withdrawalId String?         @map("withdrawal_id") @db.Uuid
  /// Shown to the user (an admin's bonus reason, for example).
  description  String
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  referral   Referral?   @relation(fields: [referralId], references: [id], onDelete: Restrict)
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([withdrawalId], map: "idx_wallet_ledger_withdrawal_id")
  @@index([userId, id], map: "idx_wallet_ledger_user_id_id")
  @@map("wallet_ledger")
}

// Payout accounts and withdrawals (product spec, Wallet: Withdrawals; backend spec, Security:
// Payments and money).

enum PayoutMethod {
  upi
  bank

  @@map("payout_method")
}

enum PayoutValidationStatus {
  pending
  validated
  failed

  @@map("payout_validation_status")
}

enum WithdrawalStatus {
  pending
  processing
  completed
  rejected
  failed

  @@map("withdrawal_status")
}

/// One immutable row per version of a user's payout details: a change supersedes the row and adds
/// another, so a withdrawal always points at the exact details it was requested against. The UPI id
/// or the account number and IFSC live only in `destination_enc` (AES-256-GCM).
model PayoutAccount {
  id                    String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  method                PayoutMethod
  /// As the user typed it.
  holderName            String                 @map("holder_name")
  /// What the bank returned for the account, once RazorpayX has validated it.
  registeredName        String?                @map("registered_name")
  /// Encrypted JSON of the destination; layout nonce | tag | ciphertext, bound to the user id.
  destinationEnc        Bytes                  @map("destination_enc")
  /// HMAC of the normalized destination: tells "same details again" apart from a change.
  destinationHash       String                 @map("destination_hash")
  /// What screens may show, e.g. "••••4321" or "ra••@okaxis".
  maskedDestination     String                 @map("masked_destination")
  validationStatus      PayoutValidationStatus @default(pending) @map("validation_status")
  /// The holder name matched the profile name. A mismatch flags withdrawals for admin review.
  isNameMatch           Boolean                @map("is_name_match")
  providerFundAccountId String?                @map("provider_fund_account_id")
  providerValidationId  String?                @map("provider_validation_id")
  supersededAt          DateTime?              @map("superseded_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawals Withdrawal[]

  @@index([userId, id], map: "idx_payout_accounts_user_id_id")
  @@index([providerValidationId], map: "idx_payout_accounts_provider_validation_id")
  @@map("payout_accounts")
}

/// The amount is reserved (debited from the ledger) when the request is made, and returned by a
/// `reversal` entry if it is rejected or the payout fails.
model Withdrawal {
  id                   String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  payoutAccountId      String           @map("payout_account_id") @db.Uuid
  amountPaise          BigInt           @map("amount_paise")
  status               WithdrawalStatus @default(pending)
  /// The client's Idempotency-Key: a retry returns this row.
  idempotencyKey       String           @map("idempotency_key")
  /// The holder name did not match the profile name when this was requested: look closer.
  isNameMismatch       Boolean          @default(false) @map("is_name_mismatch")
  rejectionReason      String?          @map("rejection_reason")
  failureReason        String?          @map("failure_reason")
  reviewedByUserId     String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt           DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  /// The RazorpayX idempotency key, fixed at approval so every attempt for this withdrawal is one payout.
  payoutIdempotencyKey String?          @map("payout_idempotency_key")
  providerPayoutId     String?          @map("provider_payout_id")
  completedAt          DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewer      User?          @relation("WithdrawalReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  payoutAccount PayoutAccount  @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  ledger        WalletLedger[]

  @@unique([userId, idempotencyKey], map: "uq_withdrawals_user_id_idempotency_key")
  @@index([userId, id], map: "idx_withdrawals_user_id_id")
  @@index([status, id], map: "idx_withdrawals_status_id")
  @@index([providerPayoutId], map: "idx_withdrawals_provider_payout_id")
  @@map("withdrawals")
}
