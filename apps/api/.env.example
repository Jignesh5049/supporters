# Local development only. Copy to .env, then run `pnpm --silent keys:generate >> .env`.
# Staging and production read these from AWS SSM Parameter Store.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
# Proxy hops in front of the API (CloudFront + Caddy = 2). 0 locally.
TRUST_PROXY=0
# Comma-separated mobile dev origins (staging only, empty in production).
CORS_ORIGINS=

# Matches docker-compose.yml. Change the ports if you set POSTGRES_PORT / VALKEY_PORT.
DATABASE_URL=postgresql://supporters:supporters-local@localhost:5432/supporters
VALKEY_URL=redis://:valkey-local@localhost:6379

# JWT_PRIVATE_KEY, JWT_KEY_ID, OTP_HMAC_KEY and TOTP_ENCRYPTION_KEY (encrypts admin TOTP secrets;
# admin sign-in is off without it): appended by `pnpm --silent keys:generate >> .env`.
# Create an admin with `pnpm admin:create --phone <+91...> --name <name>`; never commit credentials.
# Set both during a key rotation (kept for 1 day), otherwise leave empty.
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KEY_ID=

# Have I Been Pwned range check for new passwords.
BREACHED_PASSWORD_CHECK=true
# Prints OTPs to the terminal. MSG91 replaces it on staging and production.
SMS_PROVIDER=console

# Media uploads. Locally: the MinIO service in docker-compose.yml (run `pnpm storage:init` once).
# Staging and production use the instance role, with no endpoint or keys.
S3_BUCKET=supporters-media
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=minio-local-secret
# Serves the public/ prefix (media.<domain> through CloudFront in AWS).
MEDIA_PUBLIC_URL=http://localhost:9000/supporters-media
# Uploads are re-encoded by the `media` queue, which only `pnpm dev:worker` runs: without a worker
# every upload stays `processing`. No variable switches this off.

# Notifications (worker). Web push is off until all three VAPID values are set; generate a
# pair with `npx web-push generate-vapid-keys` and keep the private key in SSM.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:dev@example.com
# Optional Expo enhanced push security token.
# EXPO_ACCESS_TOKEN=
# Prints emails to the terminal; ses on staging and production (needs EMAIL_FROM).
EMAIL_PROVIDER=console
# EMAIL_FROM=no-reply@example.com
SES_REGION=ap-south-1

# Search: the meilisearch service in docker-compose.yml. MEILI_SEARCH_KEY (API, search only) and
# MEILI_INDEX_KEY (worker and reindex, documents and settings) are scoped keys appended by
# `MEILI_MASTER_KEY=meili-local-master-key pnpm --silent search:init >> .env`. The master key
# never goes in .env; on AWS it lives only in the Meilisearch container's SSM parameter.
MEILI_URL=http://localhost:7700
