# Local development only. Copy to .env, then run `pnpm --silent keys:generate >> .env`.
# Staging and production read these from AWS SSM Parameter Store.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
# Proxy hops in front of the API (CloudFront + Caddy = 2). 0 locally.
TRUST_PROXY=0
# Comma-separated mobile dev origins (staging only, empty in production).
CORS_ORIGINS=

# Matches docker-compose.yml. Change the ports if you set POSTGRES_PORT / VALKEY_PORT.
DATABASE_URL=postgresql://supporters:supporters-local@localhost:5432/supporters
VALKEY_URL=redis://:valkey-local@localhost:6379

# JWT_PRIVATE_KEY, JWT_KEY_ID and OTP_HMAC_KEY: appended by `pnpm --silent keys:generate >> .env`.
# Set both during a key rotation (kept for 1 day), otherwise leave empty.
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KEY_ID=

# Have I Been Pwned range check for new passwords.
BREACHED_PASSWORD_CHECK=true
# Prints OTPs to the terminal. MSG91 replaces it on staging and production.
SMS_PROVIDER=console

# Media uploads. Locally: the MinIO service in docker-compose.yml (run `pnpm storage:init` once).
# Staging and production use the instance role, with no endpoint or keys.
S3_BUCKET=supporters-media
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=minio-local-secret
# Serves the public/ prefix (media.<domain> through CloudFront in AWS).
MEDIA_PUBLIC_URL=http://localhost:9000/supporters-media
